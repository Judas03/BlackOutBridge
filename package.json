{
  "name": "blackoutbridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test:repo": "node --test scripts/check-public-files.test.mjs",
    "check:public": "node scripts/check-public-files.mjs --worktree",
    "setup:hooks": "node scripts/install-git-hooks.mjs",
    "firebase": "node scripts/firebase-cli.mjs",
    "check:sdk": "node scripts/check-sdk.mjs"
  },
  "dependencies": {
    "dexie": "4.4.7",
    "firebase": "13.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.10",
    "@types/react": "19.3.2",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "fake-indexeddb": "6.2.8",
    "firebase-tools": "15.37.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.2"
  }
}
