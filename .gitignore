# Public repository allowlist. New top-level locations stay local by default.
/*
!/.gitignore
!/.gitattributes
!/.env.example
!/README.md
!/LICENSE
!/package.json
!/package-lock.json
!/pnpm-lock.yaml
!/index.html
!/vite.config.*
!/vitest.config.*
!/playwright.config.*
!/tsconfig*.json
!/eslint.config.*
!/firebase.json
!/.nvmrc
!/src/
!/src/**
!/server/
!/server/**
!/public/
!/public/**
!/tests/
!/tests/**
!/docs/
!/docs/**
!/scripts/
!/scripts/**
!/.github/
!/.github/**
!/.githooks/
!/.githooks/**

# Local instructions, people-specific plans, and submission material stay private.
**/.local/
**/.private/
**/private/
**/local-only/
**/.agents/
**/.codex/
**/[Aa][Gg][Ee][Nn][Tt].[Mm][Dd]
**/[Aa][Gg][Ee][Nn][Tt][Ss].[Mm][Dd]
**/[Cc][Ll][Aa][Uu][Dd][Ee].[Mm][Dd]
**/[Gg][Ee][Mm][Ii][Nn][Ii].[Mm][Dd]
**/[Mm][Ee][Mm][Oo][Rr][Yy].[Mm][Dd]
**/*[Dd][Ee][Mm][Oo]*
**/[Mm][Yy]-[Tt][Aa][Ss][Kk][Ss]*
**/[Ff][Rr][Ii][Ee][Nn][Dd]-[Tt][Aa][Ss][Kk][Ss]*
**/[Tt][Ee][Aa][Mm]-*
**/[Rr][Oo][Ll][Ee][Ss].*
**/[Bb][Uu][Ii][Ll][Dd]-[Pp][Ll][Aa][Nn]*
**/[Tt][Oo][Dd][Oo].*
**/[Vv][Ii][Dd][Ee][Oo]-[Ss][Cc][Rr][Ii][Pp][Tt]*
**/recordings/
**/screenshots/
**/uploads/
**/exports/
**/backups/
**/evidence/
**/tmp/
**/temp/

# Secrets and generated state.
**/.env
**/.env.*
!/.env.example
**/*service-account*
**/*serviceAccount*
**/*credentials*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.sqlite*
**/*.db
**/*.dump
**/*.sql
**/*.har
**/*.log
**/*.csv
**/*.xlsx
**/*.zip
**/*.gz
**/*.tgz
**/*.tar
**/*.mp4
**/*.mov
**/*.webm
**/*.mp3
**/*.wav
**/*.m4a
**/*.png
**/*.jpg
**/*.jpeg
**/*.webp
**/*.pdf
**/node_modules/
**/dist/
**/coverage/
**/test-results/
**/playwright-report/
**/.firebase/
**/.cache/
**/.DS_Store
